{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://push-in.github.io/pam-native/schemas/package-budget-report.json",
  "title": "PAM Native package budget report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultCode", "artifacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "resultCode": {"type": "integer", "enum": [1, 2]},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactCode", "resultCode", "actualBytes", "maximumBytes", "sha256"],
        "properties": {
          "artifactCode": {"type": "integer", "enum": [1, 2, 3, 4]},
          "resultCode": {"type": "integer", "enum": [1, 2]},
          "actualBytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
          "maximumBytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
