{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pam.dev/schemas/native-package-reproducibility.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultCode", "artifacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "resultCode": {"type": "integer", "enum": [1, 2]},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactCode", "resultCode", "bytes", "sha256"],
        "properties": {
          "artifactCode": {"type": "integer", "minimum": 1, "maximum": 4},
          "resultCode": {"type": "integer", "enum": [1, 2]},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
