<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180 dp). pam-native.json "android.tv.banner"
     replaces it with the app's own PNG; this default draws the launcher icon
     on the splash background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pam_splash_background" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item
        android:width="112dp"
        android:height="112dp"
        android:gravity="center"
        android:drawable="@drawable/pam_launcher" />
</layer-list>
