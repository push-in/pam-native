<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device (allowBackup="false" does not stop Android 12+
    device-to-device transfer; these rules do). Every domain is listed:
    "root" only matches the data directory itself, while files/, databases/
    and shared_prefs/ are separate domains. Moving keystore-bound secrets or
    push tokens to another device would leave them unreadable or duplicated.
    An application that wants backups overrides this resource.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
