{
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    },
    "platform-check": true,
    "sort-packages": true
  },
  "description": "PAM TV: a Netflix-style Android TV app in PHP, driven by the remote.",
  "license": "proprietary",
  "name": "pam/example-native-tv",
  "require": {
    "php": "^8.5",
    "pushinbr/pam-native": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "native:benchmark": "pam benchmark .",
    "native:build": "pam build . --release",
    "native:dev": "pam dev .",
    "native:doctor": "pam doctor .",
    "native:profile": "pam profile .",
    "test": "pam test . --phpunit -c phpunit.xml"
  },
  "type": "project",
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/native",
      "options": {
        "symlink": false,
        "versions": {
          "pushinbr/pam-native": "1.0.0"
        }
      }
    }
  ]
}
