{
    "name": "pam/example-native-showcase",
    "description": "Pam Native Android showcase application.",
    "type": "project",
    "license": "BUSL-1.1",
    "require": {
        "php": "^8.4",
        "pam/native": "^0.1",
        "pam-community/example-plugin": "^0.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/native",
            "options": {
                "symlink": false,
                "versions": {
                    "pam/native": "0.1.1"
                }
            }
        },
        {
            "type": "path",
            "url": "../community-plugin",
            "options": {
                "symlink": false,
                "versions": {
                    "pam-community/example-plugin": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
