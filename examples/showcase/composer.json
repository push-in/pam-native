{
    "name": "pam/example-native-showcase",
    "description": "Pam Native Android showcase application.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native": "^0.8.0",
        "pam-community/example-plugin": "^0.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/native",
            "options": {
                "symlink": false,
                "versions": {
                    "pushinbr/pam-native": "0.8.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../community-plugin",
            "options": {
                "symlink": false,
                "versions": {
                    "pam-community/example-plugin": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
