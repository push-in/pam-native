<Screen>
    <StatusBar backgroundColor="#FF172013" appearance="light" />
    <SafeAreaView class="flex-1" backgroundColor="#FF172013">
        <Column class="flex-1" backgroundColor="#FFF4F3EA">
            <Column paddingHorizontal="18" paddingBottom="18" backgroundColor="#FF172013">
                <Row height="62" gap="12">
                    <Pressable
                        width="48"
                        height="48"
                        borderRadius="16"
                        backgroundColor="#FF2C3A25"
                        rippleColor="#33D4E6C5"
                        pressedOpacity="0.9"
                        on:press="back"
                        accessibilityLabel="Voltar para galeria"
                    >
                        <Text height="48" textColor="#FFD4E6C5" textAlign="center" fontSize="24" fontWeight="700">←</Text>
                    </Pressable>
                    <Column flexGrow="1">
                        <Text height="23" textColor="#FFAAB99C" fontSize="12">ROTA NORTE · EQUIPE 04</Text>
                        <Text height="28" textColor="#FFFFFFFF" fontSize="18" fontWeight="700">Operação em campo</Text>
                    </Column>
                    <Column width="48" height="48" borderRadius="15" backgroundColor="#FF2C3A25">
                        <Text height="48" textColor="#FFD4E6C5" textAlign="center" fontSize="13" fontWeight="700">04</Text>
                    </Column>
                </Row>
                <Column padding="16" gap="7" borderRadius="20" backgroundColor="#FF26351F">
                    <Text height="22" textColor="#FFAAB99C" fontSize="12">PRÓXIMA VISITA</Text>
                    <Text height="30" textColor="#FFFFFFFF" fontSize="20" fontWeight="700">Fazenda Boa Vista</Text>
                    <Text height="23" textColor="#FFD4E6C5" fontSize="13">BR-010, km 42 · 18 min</Text>
                    <Row height="44" gap="8">
                        <Column flexGrow="1" borderRadius="13" backgroundColor="#FF34472C">
                            <Text height="44" textColor="#FFE8F4DF" textAlign="center" fontSize="12" fontWeight="700">ABRIR ROTA</Text>
                        </Column>
                        <Column flexGrow="1" borderRadius="13" backgroundColor="#FFB9D532">
                            <Text height="44" textColor="#FF253000" textAlign="center" fontSize="12" fontWeight="700">INICIAR VISITA</Text>
                        </Column>
                    </Row>
                </Column>
            </Column>
            <ScrollView class="flex-1">
                <Column padding="18" gap="14">
                    <Row height="54">
                        <Column flexGrow="1">
                            <Text height="27" textColor="#FF283120" fontSize="18" fontWeight="700">Roteiro de hoje</Text>
                            <Text height="22" textColor="#FF7A826F" fontSize="12">2 de 6 visitas concluídas</Text>
                        </Column>
                        <Column width="58" height="40" borderRadius="13" backgroundColor="#FFE6E8D8">
                            <Text height="40" textColor="#FF5F694F" textAlign="center" fontSize="12" fontWeight="700">33%</Text>
                        </Column>
                    </Row>
                    <Column padding="15" gap="10" borderRadius="18" backgroundColor="#FFFFFFFF">
                        <Row height="52" gap="12">
                            <Column width="44" height="44" borderRadius="14" backgroundColor="#FFE7F2DD">
                                <Text height="44" textColor="#FF4B7130" textAlign="center" fontSize="14" fontWeight="700">01</Text>
                            </Column>
                            <Column flexGrow="1">
                                <Text height="25" textColor="#FF283120" fontSize="15" fontWeight="700">Cooperativa São José</Text>
                                <Text height="21" textColor="#FF6F7C63" fontSize="12">Concluída · 08:20</Text>
                            </Column>
                            <Text width="28" height="44" textColor="#FF5C8B3B" fontSize="21" fontWeight="700">✓</Text>
                        </Row>
                        <Row height="52" gap="12">
                            <Column width="44" height="44" borderRadius="14" backgroundColor="#FFFFF0C7">
                                <Text height="44" textColor="#FF8B6807" textAlign="center" fontSize="14" fontWeight="700">02</Text>
                            </Column>
                            <Column flexGrow="1">
                                <Text height="25" textColor="#FF283120" fontSize="15" fontWeight="700">Fazenda Boa Vista</Text>
                                <Text height="21" textColor="#FF8B6807" fontSize="12">Próxima · 10:15</Text>
                            </Column>
                            <Text width="28" height="44" textColor="#FF8B6807" fontSize="21" fontWeight="700">›</Text>
                        </Row>
                        <Row height="52" gap="12">
                            <Column width="44" height="44" borderRadius="14" backgroundColor="#FFF0F1E9">
                                <Text height="44" textColor="#FF7A826F" textAlign="center" fontSize="14" fontWeight="700">03</Text>
                            </Column>
                            <Column flexGrow="1">
                                <Text height="25" textColor="#FF283120" fontSize="15" fontWeight="700">Sítio Horizonte</Text>
                                <Text height="21" textColor="#FF7A826F" fontSize="12">11:40 · 14 km</Text>
                            </Column>
                        </Row>
                    </Column>
                    <Column padding="16" gap="8" borderRadius="18" backgroundColor="#FFFFF8DB" borderWidth="1" borderColor="#FFE7D890">
                        <Text height="23" textColor="#FF6C570A" fontSize="13" fontWeight="700">MODO RESILIENTE</Text>
                        <Text height="24" textColor="#FF39351F" fontSize="14">{{ $connectionLabel }}</Text>
                        <Text height="38" textColor="#FF766F48" fontSize="12" lineHeight="18">Fotos, formulários e assinaturas ficam na fila local até a conexão voltar.</Text>
                    </Column>
                </Column>
            </ScrollView>
            <Column padding="12" backgroundColor="#FFF4F3EA">
                <Button
                    height="56"
                    borderRadius="18"
                    backgroundColor="#FFB9D532"
                    textColor="#FF253000"
                    fontWeight="700"
                    on:press="sync"
                    accessibilityLabel="Sincronizar registros locais"
                >{{ $syncLabel }}</Button>
            </Column>
        </Column>
    </SafeAreaView>
</Screen>
