#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadCandidates = [
    dirname(__DIR__, 3).'/autoload.php',
    dirname(__DIR__).'/vendor/autoload.php',
];
$loaded = false;
foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        $loaded = true;
        break;
    }
}
if (!$loaded) {
    spl_autoload_register(static function (string $class): void {
        $prefix = 'Pam\\Native\\';
        if (!str_starts_with($class, $prefix)) {
            return;
        }
        $path = dirname(__DIR__).'/src/'
            .str_replace('\\', '/', substr($class, strlen($prefix))).'.php';
        if (is_file($path)) {
            require $path;
        }
    });
}

use Pam\Native\Tooling\PamFormatter;

$check = false;
$stdin = false;
$filename = '<stdin>.pam';
$paths = [];
for ($index = 1; $index < count($argv); $index++) {
    $argument = $argv[$index];
    if ($argument === '--check') {
        $check = true;
        continue;
    }
    if ($argument === '--stdin') {
        $stdin = true;
        continue;
    }
    if ($argument === '--filename') {
        $filename = $argv[++$index] ?? '';
        if ($filename === '') {
            fwrite(STDERR, "--filename requires a value\n");
            exit(2);
        }
        continue;
    }
    $paths[] = $argument;
}
if ($stdin && $paths !== []) {
    fwrite(STDERR, "--stdin cannot be combined with file paths\n");
    exit(2);
}
if (!$stdin && $paths === []) {
    fwrite(STDERR, "Usage: pam-native-format [--check] <file-or-directory> [...]\n       pam-native-format --stdin [--filename Component.pam]\n");
    exit(2);
}

if ($stdin) {
    try {
        $source = stream_get_contents(STDIN);
        if ($source === false) {
            throw new RuntimeException('Cannot read formatter input.');
        }
        $formatted = PamFormatter::format($source, $filename);
        if ($check) {
            exit(hash_equals($source, $formatted) ? 0 : 1);
        }
        fwrite(STDOUT, $formatted);
        exit(0);
    } catch (Throwable $error) {
        fwrite(STDERR, $error->getMessage()."\n");
        exit(1);
    }
}

$files = [];
foreach ($paths as $path) {
    if (is_file($path)) {
        $files[] = $path;
        continue;
    }
    if (!is_dir($path)) {
        fwrite(STDERR, "Path does not exist: {$path}\n");
        exit(2);
    }
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS),
    );
    foreach ($iterator as $file) {
        if ($file->isFile() && (
            str_ends_with($file->getFilename(), '.pam.php')
            || str_ends_with($file->getFilename(), '.pam')
        )) {
            $files[] = $file->getPathname();
        }
    }
}
$files = array_values(array_unique($files));
sort($files, SORT_STRING);
$changed = 0;
try {
    foreach ($files as $file) {
        if (PamFormatter::formatFile($file, $check)) {
            $changed++;
            fwrite(STDOUT, ($check ? 'Needs formatting: ' : 'Formatted: ').$file."\n");
        }
    }
} catch (Throwable $error) {
    fwrite(STDERR, $error->getMessage()."\n");
    exit(1);
}
if ($check && $changed > 0) {
    exit(1);
}
fwrite(STDOUT, "PAM components checked: ".count($files)."; changed: {$changed}.\n");
