{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pam.dev/schemas/pam-native-plugin.v1.schema.json",
    "title": "Pam Native Composer plugin manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "protocol",
        "pamNative"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "version": {
            "const": 1
        },
        "protocol": {
            "const": 1
        },
        "pamNative": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "minimum",
                "maximumExclusive"
            ],
            "properties": {
                "minimum": {
                    "$ref": "#/$defs/version"
                },
                "maximumExclusive": {
                    "$ref": "#/$defs/version"
                }
            }
        },
        "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "required": {
                    "$ref": "#/$defs/capabilities"
                },
                "optional": {
                    "$ref": "#/$defs/capabilities"
                }
            }
        },
        "php": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "provider": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\\\[A-Za-z_][A-Za-z0-9_]*)+$"
                }
            }
        },
        "android": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "namespace": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
                },
                "minSdk": {
                    "type": "integer",
                    "minimum": 26,
                    "maximum": 36,
                    "default": 26
                },
                "permissions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^android\\.permission\\.(?:[a-z][a-z0-9_]*\\.)*[A-Z][A-Z0-9_]*$"
                    }
                },
                "repositories": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^https://"
                    }
                },
                "dependencies": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.+\\[\\](),-]+(:[A-Za-z0-9_.-]+)?$"
                    }
                },
                "localAars": {
                    "$ref": "#/$defs/paths"
                },
                "sourceDirs": {
                    "$ref": "#/$defs/paths"
                },
                "resourceDirs": {
                    "$ref": "#/$defs/paths"
                },
                "assetDirs": {
                    "$ref": "#/$defs/paths"
                },
                "jniLibDirs": {
                    "$ref": "#/$defs/paths"
                },
                "manifest": {
                    "$ref": "#/$defs/path"
                },
                "consumerRules": {
                    "$ref": "#/$defs/path"
                }
            }
        },
        "ios": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "minimumVersion": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+$",
                    "default": "15.0"
                },
                "sourceDirs": {
                    "$ref": "#/$defs/paths"
                },
                "resourceDirs": {
                    "$ref": "#/$defs/paths"
                },
                "swiftPackages": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/swiftPackage"
                    }
                },
                "frameworks": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/appleIdentifier"
                    }
                },
                "usageDescriptions": {
                    "type": "object",
                    "propertyNames": {
                        "pattern": "^(?:NS[A-Za-z0-9_]+|NFCReader)UsageDescription$"
                    },
                    "additionalProperties": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                    }
                },
                "entitlements": {
                    "$ref": "#/$defs/path"
                },
                "infoPlist": {
                    "$ref": "#/$defs/path"
                },
                "extensions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/iosExtension"
                    }
                }
            }
        },
        "idl": {
            "$ref": "#/$defs/path"
        },
        "modules": {
            "$ref": "#/$defs/nativeBindings"
        },
        "views": {
            "$ref": "#/$defs/nativeBindings"
        },
        "share": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "configKey"
            ],
            "description": "Content received from other apps' share sheets. Pam Native generates the Android SEND/SEND_MULTIPLE intent filters and the iOS Share Extension NSExtensionActivationRule from it; applications override accept and multiple under plugins.<configKey> in pam-native.json. Declare the plugins.share.v1 capability.",
            "properties": {
                "configKey": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
                },
                "accept": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/shareMimeType"
                    },
                    "default": [
                        "*/*"
                    ]
                },
                "multiple": {
                    "$ref": "#/$defs/shareMultiple",
                    "default": true
                }
            }
        }
    },
    "$defs": {
        "shareMimeType": {
            "type": "string",
            "pattern": "^[a-z0-9!#$&^_.+*-]+/(?:[a-z0-9!#$&^_.+*-]+|\\*)$"
        },
        "shareMultiple": {
            "description": "true: every accepted type may arrive several at once; false: single items only; or the accepted types that may arrive several at once.",
            "oneOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "array",
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/shareMimeType"
                    }
                }
            ]
        },
        "capabilities": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){1,7}$"
            }
        },
        "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000]+$"
        },
        "paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/path"
            }
        },
        "nativeBindings": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "class"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                    },
                    "class": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
                    },
                    "iosClass": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
                    }
                }
            }
        },
        "appleIdentifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.+-]*$"
        },
        "swiftPackage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "requirement", "products"],
            "properties": {
                "url": {
                    "type": "string",
                    "pattern": "^https://[^\\u0000\\r\\n\\\"]+\\.git$",
                    "maxLength": 2048
                },
                "requirement": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "value"],
                    "properties": {
                        "kind": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 5
                        },
                        "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                        }
                    }
                },
                "products": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/appleIdentifier"
                    }
                }
            }
        },
        "iosExtension": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "bundleSuffix", "sourceDirs"],
            "properties": {
                "kind": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                },
                "name": {
                    "$ref": "#/$defs/appleIdentifier"
                },
                "bundleSuffix": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)*$",
                    "maxLength": 120
                },
                "sourceDirs": {
                    "$ref": "#/$defs/paths"
                },
                "resourceDirs": {
                    "$ref": "#/$defs/paths"
                },
                "entitlements": {
                    "$ref": "#/$defs/path"
                },
                "infoPlist": {
                    "$ref": "#/$defs/path"
                }
            }
        }
    }
}
