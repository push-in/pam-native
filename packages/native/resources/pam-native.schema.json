{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pam.dev/schemas/pam-native.v1.schema.json",
    "title": "Pam Native application manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "applicationId",
        "name",
        "entry"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "version": {
            "const": 1
        },
        "applicationId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
        },
        "entry": {
            "type": "string",
            "pattern": "^[^/\\\\][^\\u0000]*\\.php$"
        },
        "runtime": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "php": {
                    "type": "string",
                    "pattern": "^8\\.[45]$",
                    "default": "8.5"
                },
                "channel": {
                    "type": "string",
                    "enum": [
                        "stable"
                    ],
                    "default": "stable"
                }
            }
        },
        "versionCode": {
            "type": "integer",
            "minimum": 1,
            "default": 1
        },
        "versionName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "default": "0.2.1"
        },
        "android": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "minSdk": {
                    "type": "integer",
                    "minimum": 26,
                    "maximum": 36,
                    "default": 26
                },
                "targetSdk": {
                    "type": "integer",
                    "minimum": 26,
                    "maximum": 36,
                    "default": 36
                },
                "debugApplicationIdSuffix": {
                    "type": "string",
                    "pattern": "^\\.[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"
                },
                "permissions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^android\\.permission\\.[A-Z0-9_]+$"
                    }
                },
                "deepLinks": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "scheme"
                        ],
                        "properties": {
                            "scheme": {
                                "type": "string",
                                "pattern": "^[A-Za-z][A-Za-z0-9+.-]{0,63}$"
                            },
                            "host": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 253,
                                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
                            },
                            "pathPrefix": {
                                "type": "string",
                                "pattern": "^/[^\\u0000\\r\\n\"<>&]{0,511}$"
                            },
                            "autoVerify": {
                                "type": "boolean",
                                "default": false
                            }
                        }
                    }
                },
                "shareTargets": {
                    "type": "array",
                    "uniqueItems": true,
                    "maxItems": 16,
                    "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9!#$&^_.+*-]+/(?:[A-Za-z0-9!#$&^_.+*-]+|\\*)$"
                    }
                }
            }
        },
        "ios": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "minimumVersion": {
                    "type": "string",
                    "pattern": "^(?:1[5-9]|[2-9][0-9])\\.[0-9]+$",
                    "default": "15.0"
                }
            }
        },
        "appearance": {
            "type": "object",
            "additionalProperties": false,
            "description": "Native light/dark window colours applied before the first PHP frame and the default Appearance mode.",
            "properties": {
                "defaultMode": {
                    "enum": [
                        "system",
                        "light",
                        "dark"
                    ],
                    "default": "system",
                    "description": "Preference used until the app calls Appearance::set()."
                },
                "legacyStartingWindow": {
                    "enum": [
                        "theme",
                        "none"
                    ],
                    "default": "theme",
                    "description": "Android 8-11 draw the starting window from the system scheme before the app process starts, so it cannot follow a persisted override. \"none\" skips it so a mismatched scheme is never shown; Android 12+ always keeps its splash screen."
                },
                "light": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Colours for the light scheme.",
                    "properties": {
                        "background": {
                            "type": "string",
                            "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
                            "default": "#FFFFFF",
                            "description": "Window background painted before the first PHP frame."
                        },
                        "statusBar": {
                            "type": "string",
                            "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
                            "description": "Status bar colour before edge-to-edge content; defaults to background. Icon contrast is derived from its luminance."
                        },
                        "navigationBar": {
                            "type": "string",
                            "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
                            "description": "Navigation bar colour before edge-to-edge content; defaults to background. Icon contrast is derived from its luminance."
                        },
                        "splashBackground": {
                            "type": "string",
                            "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
                            "description": "Android 12+ splash screen background; defaults to background."
                        }
                    }
                },
                "dark": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Colours for the dark scheme.",
                    "properties": {
                        "background": {
                            "type": "string",
                            "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
                            "default": "#121212",
                            "description": "Window background painted before the first PHP frame."
                        },
                        "statusBar": {
                            "type": "string",
                            "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
                            "description": "Status bar colour before edge-to-edge content; defaults to background. Icon contrast is derived from its luminance."
                        },
                        "navigationBar": {
                            "type": "string",
                            "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
                            "description": "Navigation bar colour before edge-to-edge content; defaults to background. Icon contrast is derived from its luminance."
                        },
                        "splashBackground": {
                            "type": "string",
                            "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
                            "description": "Android 12+ splash screen background; defaults to background."
                        }
                    }
                }
            }
        },
        "modules": {
            "$ref": "#/$defs/nativeBindings"
        },
        "views": {
            "$ref": "#/$defs/nativeBindings"
        }
    },
    "$defs": {
        "nativeBindings": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "class"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                    },
                    "class": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
                    }
                }
            }
        }
    }
}
